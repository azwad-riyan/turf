{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "dynamicRoutes": [
    {
      "page": "/api/v1/analytics/turf-performance/[turfId]",
      "regex": "^/api/v1/analytics/turf\\-performance/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPturfId": "nxtPturfId"
      },
      "namedRegex": "^/api/v1/analytics/turf\\-performance/(?<nxtPturfId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/v1/bookings/turf/[turfId]",
      "regex": "^/api/v1/bookings/turf/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPturfId": "nxtPturfId"
      },
      "namedRegex": "^/api/v1/bookings/turf/(?<nxtPturfId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/v1/bookings/[id]",
      "regex": "^/api/v1/bookings/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/v1/bookings/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/v1/bookings/[id]/cancel",
      "regex": "^/api/v1/bookings/([^/]+?)/cancel(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/v1/bookings/(?<nxtPid>[^/]+?)/cancel(?:/)?$"
    },
    {
      "page": "/api/v1/reviews/turf/[turfId]",
      "regex": "^/api/v1/reviews/turf/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPturfId": "nxtPturfId"
      },
      "namedRegex": "^/api/v1/reviews/turf/(?<nxtPturfId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/v1/turfs/[id]",
      "regex": "^/api/v1/turfs/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/v1/turfs/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/v1/turfs/[id]/availability",
      "regex": "^/api/v1/turfs/([^/]+?)/availability(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/v1/turfs/(?<nxtPid>[^/]+?)/availability(?:/)?$"
    },
    {
      "page": "/api/v1/turfs/[id]/overrides",
      "regex": "^/api/v1/turfs/([^/]+?)/overrides(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/v1/turfs/(?<nxtPid>[^/]+?)/overrides(?:/)?$"
    },
    {
      "page": "/api/v1/turfs/[id]/schedules",
      "regex": "^/api/v1/turfs/([^/]+?)/schedules(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/v1/turfs/(?<nxtPid>[^/]+?)/schedules(?:/)?$"
    },
    {
      "page": "/api/v1/turfs/[id]/slots",
      "regex": "^/api/v1/turfs/([^/]+?)/slots(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/v1/turfs/(?<nxtPid>[^/]+?)/slots(?:/)?$"
    },
    {
      "page": "/api/v1/turfs/[id]/upload-photo",
      "regex": "^/api/v1/turfs/([^/]+?)/upload\\-photo(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/v1/turfs/(?<nxtPid>[^/]+?)/upload\\-photo(?:/)?$"
    },
    {
      "page": "/book/[id]",
      "regex": "^/book/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/book/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/turfs/[id]",
      "regex": "^/turfs/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/turfs/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/auth/login",
      "regex": "^/auth/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/auth/login(?:/)?$"
    },
    {
      "page": "/auth/register",
      "regex": "^/auth/register(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/auth/register(?:/)?$"
    },
    {
      "page": "/dashboard",
      "regex": "^/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard(?:/)?$"
    },
    {
      "page": "/turfs",
      "regex": "^/turfs(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/turfs(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "RSC",
    "varyHeader": "RSC, Next-Router-State-Tree, Next-Router-Prefetch, Next-Router-Segment-Prefetch",
    "prefetchHeader": "Next-Router-Prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "Next-Router-Segment-Prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://localhost:8000/api/:path*",
      "regex": "^/api(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    }
  ]
}