# ──────────────────────────────────────────
# Turf Booking Platform — Environment Config
# Copy this to .env and fill in your values
# ──────────────────────────────────────────

# ── Django ──────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-50-char-random-string
DJANGO_SETTINGS_MODULE=core.settings.development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── PostgreSQL ───────────────────────────
POSTGRES_DB=turfdb
POSTGRES_USER=turfuser
POSTGRES_PASSWORD=turfpass
DATABASE_URL=postgresql://turfuser:turfpass@postgres:5432/turfdb

# ── Redis ────────────────────────────────
REDIS_PASSWORD=redispass
REDIS_URL=redis://:redispass@redis:6379/0

# Slot lock duration in seconds (how long a slot is reserved during checkout)
SLOT_LOCK_TTL=180

# ── Auth ─────────────────────────────────
# OTP expiry for player phone login (seconds)
OTP_EXPIRY_SECONDS=300
# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# ── SMS Gateway (BD Bulk SMS) ─────────────
# Phase 1 stub — add your provider credentials
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER_ID=TurfBook
SMS_GATEWAY_URL=https://your-bd-sms-provider.com/api/send

# ── WhatsApp Business Cloud API ───────────
# Phase 2 — reuse existing Meta API integration
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ── Payments (Phase 2) ────────────────────
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_BASE_URL=https://api.mynagad.com

# ── File Storage ─────────────────────────
# Local (development) or Cloudflare R2 (production)
USE_S3=False
# Cloudflare R2 (when USE_S3=True)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
AWS_S3_CUSTOM_DOMAIN=

# ── Platform Config ──────────────────────
PLATFORM_FEE_AMOUNT=75
CURRENCY=BDT

# ── Frontend ─────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_MAPS_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
