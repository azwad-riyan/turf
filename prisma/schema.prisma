// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PLAYER
  OWNER
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum SportType {
  FOOTBALL
  CRICKET
  VOLLEYBALL
}

enum SlotOverrideStatus {
  BLOCKED
  SPECIAL_PRICE
}

enum BookingSource {
  ONLINE
  OFFLINE_MANUAL
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentMethod {
  CASH
  BKASH
  NAGAD
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum PaymentProvider {
  CASH
  BKASH
  NAGAD
}

enum PaymentLogStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
}

enum NotificationChannel {
  SMS
  WHATSAPP
  EMAIL
}

enum NotificationStatus {
  SENT
  FAILED
  STUB
}

model User {
  id        String   @id @db.Uuid
  email     String   @unique
  phone     String?
  name      String?
  role      Role     @default(PLAYER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerProfile  Owner?
  bookings      Booking[] @relation("PlayerBookings")
  bookingsCreatedAsPlayer Booking[] @relation("CreatedByPlayer")
  bookingsCreatedAsOwner Booking[] @relation("CreatedByOwner")
  bookingAuditLogs BookingAuditLog[]
  reviews       Review[]
}

model Owner {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @db.Uuid
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName       String
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  notes              String?
  createdAt          DateTime           @default(now())

  turfs              Turf[]
  payouts            Payout[]
}

model Turf {
  id                 String      @id @default(uuid()) @db.Uuid
  ownerId            String      @db.Uuid
  owner              Owner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  address            String
  area               String
  lat                Decimal?
  lng                Decimal?
  sportTypes         SportType[]
  amenities          String[]
  basePrice          Int
  contactPhone       String?
  isActive           Boolean     @default(true)
  cancellationHours  Int         @default(3)
  averageRating      Decimal     @default(0.00) @db.Decimal(3, 2)
  totalReviews       Int         @default(0)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  photos             TurfPhoto[]
  schedules          OperatingSchedule[]
  slotOverrides      SlotOverride[]
  bookings           Booking[]
  reviews            Review[]
}

model TurfPhoto {
  id         String   @id @default(uuid()) @db.Uuid
  turfId     String   @db.Uuid
  turf       Turf     @relation(fields: [turfId], references: [id], onDelete: Cascade)
  image      String
  isPrimary  Boolean  @default(false)
  order      Int      @default(0)
  uploadedAt DateTime @default(now())
}

model OperatingSchedule {
  id               String   @id @default(uuid()) @db.Uuid
  turfId           String   @db.Uuid
  turf             Turf     @relation(fields: [turfId], references: [id], onDelete: Cascade)
  dayOfWeek        Int
  openTime         DateTime @db.Time()
  closeTime        DateTime @db.Time()
  slotDurationMin  Int      @default(90)
  isClosed         Boolean  @default(false)

  @@unique([turfId, dayOfWeek])
}

model SlotOverride {
  id         String             @id @default(uuid()) @db.Uuid
  turfId     String             @db.Uuid
  turf       Turf               @relation(fields: [turfId], references: [id], onDelete: Cascade)
  date       DateTime           @db.Date
  startTime  DateTime           @db.Time()
  endTime    DateTime           @db.Time()
  status     SlotOverrideStatus @default(BLOCKED)
  price      Int?
  reason     String?
  createdAt  DateTime           @default(now())
}

model Booking {
  id               String         @id @default(uuid()) @db.Uuid
  turfId           String         @db.Uuid
  turf             Turf           @relation(fields: [turfId], references: [id], onDelete: Restrict)
  playerId         String?        @db.Uuid
  player           User?          @relation("PlayerBookings", fields: [playerId], references: [id], onDelete: SetNull)
  playerName       String?
  playerEmail      String?
  playerPhone      String?
  playerCount      Int            @default(1)
  
  date             DateTime       @db.Date
  startTime        DateTime       @db.Time()
  endTime          DateTime       @db.Time()

  source           BookingSource  @default(ONLINE)
  status           BookingStatus  @default(CONFIRMED)
  paymentMethod    PaymentMethod  @default(CASH)
  paymentStatus    PaymentStatus  @default(UNPAID)
  
  amount           Int
  platformFee      Int
  amountPaid       Int            @default(0)

  createdByPlayerId String?       @db.Uuid
  createdByPlayer   User?         @relation("CreatedByPlayer", fields: [createdByPlayerId], references: [id], onDelete: SetNull)
  createdByOwnerId  String?       @db.Uuid
  createdByOwner    User?         @relation("CreatedByOwner", fields: [createdByOwnerId], references: [id], onDelete: SetNull)
  
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  cancelledAt      DateTime?
  cancellationReason String?

  auditLogs        BookingAuditLog[]
  payments         Payment[]
  review           Review?
  notifications    NotificationLog[]
}

model BookingAuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  bookingId      String   @db.Uuid
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  changedById    String?  @db.Uuid
  changedBy      User?    @relation(fields: [changedById], references: [id], onDelete: SetNull)
  previousStatus String
  newStatus      String
  reason         String?
  createdAt      DateTime @default(now())
}

model Payment {
  id             String            @id @default(uuid()) @db.Uuid
  bookingId      String            @db.Uuid
  booking        Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider       PaymentProvider
  providerTxnId  String?
  amount         Int
  status         PaymentLogStatus  @default(PENDING)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model Payout {
  id             String         @id @default(uuid()) @db.Uuid
  ownerId        String         @db.Uuid
  owner          Owner          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  periodStart    DateTime       @db.Date
  periodEnd      DateTime       @db.Date
  grossAmount    Int
  feeDeducted    Int
  netPayout      Int
  status         PayoutStatus   @default(PENDING)
  paidAt         DateTime?
  notes          String?
  createdAt      DateTime       @default(now())
}

model Review {
  id           String   @id @default(uuid()) @db.Uuid
  turfId       String   @db.Uuid
  turf         Turf     @relation(fields: [turfId], references: [id], onDelete: Cascade)
  bookingId    String?  @unique @db.Uuid
  booking      Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  playerId     String?  @db.Uuid
  player       User?    @relation(fields: [playerId], references: [id], onDelete: SetNull)
  playerName   String?
  rating       Int
  comment      String?
  isFlagged    Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model NotificationLog {
  id           String              @id @default(uuid()) @db.Uuid
  bookingId    String?             @db.Uuid
  booking      Booking?            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  email        String?
  phone        String?
  channel      NotificationChannel
  messageType  String              @default("generic")
  status       NotificationStatus  @default(STUB)
  sentAt       DateTime            @default(now())
  errorMessage String?
}

model SlotLock {
  id          String   @id @default(cuid())
  turfId      String
  date        DateTime @db.Date
  startTime   DateTime @db.Time
  sessionId   String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@unique([turfId, date, startTime])
}